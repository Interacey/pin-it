// VER_COMMA ("0,1,0,0") and VER_STR ("0.1.0") are passed in by build.rs from Cargo.toml.
#define RT_MANIFEST 24

1 ICON "pin_it.ico"
1 RT_MANIFEST "pin_it.manifest"

1 VERSIONINFO
FILEVERSION VER_COMMA
PRODUCTVERSION VER_COMMA
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Pin It"
            VALUE "FileDescription", "Pin It - window pinning tool"
            VALUE "FileVersion", VER_STR
            VALUE "InternalName", "pin_it"
            VALUE "LegalCopyright", "Copyright (C) 2026 Pin It"
            VALUE "OriginalFilename", "pin_it.exe"
            VALUE "ProductName", "Pin It"
            VALUE "ProductVersion", VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
